      <column caption='Rating &gt;= 4.0' datatype='integer' name='[Calculation_0345022312222720]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Rating] &gt;= 4.0 THEN 1 ELSE 0 END' />
      </column>
      <column caption='Install Tier' datatype='string' name='[Calculation_0345022312304641]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Installs] &gt;= 100000000 THEN &quot;100M+ (Mega-Hit)&quot;ELSEIF [Installs] &gt;= 10000000 THEN &quot;10M - 100M (High)&quot;ELSEIF [Installs] &gt;= 1000000 THEN &quot;1M - 10M (Medium)&quot;ELSEIF [Installs] &gt;= 100000 THEN &quot;100K - 1M (Moderate)&quot;ELSE &quot;&lt; 100K (Niche/Emerging)&quot;END' />
      </column>
      <column caption='Size Tier (MB)' datatype='string' name='[Calculation_0345022312833026]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Size_MB]) THEN &quot;Device Dependent&quot;&#13;&#10;ELSEIF [Size_MB] &lt; 10 THEN &quot;&lt; 10 MB (Lightweight)&quot;&#13;&#10;ELSEIF [Size_MB] &lt;= 25 THEN &quot;10 - 25 MB (Optimal)&quot;&#13;&#10;ELSEIF [Size_MB] &lt;= 50 THEN &quot;25 - 50 MB (Moderate)&quot;&#13;&#10;ELSE &quot;50+ MB (Heavy)&quot;&#13;&#10;END' />
      </column>
      <column caption='Sentiment Group]' datatype='string' name='[Calculation_0345022312968195]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Sentiment_Polarity] &gt; 0.1 THEN &quot;Positive&quot;&#13;&#10;ELSEIF [Sentiment_Polarity] &lt; -0.1 THEN &quot;Negative&quot;&#13;&#10;ELSE &quot;Neutral&quot;&#13;&#10;END' />
      </column>
      <column caption='Price Tier' datatype='string' name='[Calculation_0345022327603205]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] = 0 OR [Type] = &quot;Free&quot; THEN &quot;Free ($0)&quot;&#13;&#10;ELSEIF [Price] &lt;= 2.99 THEN &quot;$0.99 - $2.99&quot;&#13;&#10;ELSEIF [Price] &lt;= 9.99 THEN &quot;$3.00 - $9.99&quot;&#13;&#10;ELSEIF [Price] &lt;= 29.99 THEN &quot;$10.00 - $29.99&quot;&#13;&#10;ELSE &quot;$30.00+ (High / Luxury)&quot;&#13;&#10;END' />
      </column>
