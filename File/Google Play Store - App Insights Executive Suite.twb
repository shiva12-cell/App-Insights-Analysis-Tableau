          <datasource-dependencies datasource='federated.1w4hbcd0u7kkkb15605f714jhjb2'>
            <column caption='Android Ver' datatype='string' name='[Android_Ver]' role='dimension' type='nominal' />
            <column caption='Size Tier (MB)' datatype='string' name='[Calculation_0345022312833026]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Size_MB]) THEN &quot;Device Dependent&quot;&#13;&#10;ELSEIF [Size_MB] &lt; 10 THEN &quot;&lt; 10 MB (Lightweight)&quot;&#13;&#10;ELSEIF [Size_MB] &lt;= 25 THEN &quot;10 - 25 MB (Optimal)&quot;&#13;&#10;ELSEIF [Size_MB] &lt;= 50 THEN &quot;25 - 50 MB (Moderate)&quot;&#13;&#10;ELSE &quot;50+ MB (Heavy)&quot;&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column caption='Content Rating' datatype='string' name='[Content_Rating]' role='dimension' type='nominal' />
            <column datatype='real' name='[Rating]' role='measure' type='quantitative' />
            <column aggregation='None' caption='Size MB (bin)' datatype='integer' name='[Size MB (bin)]' role='dimension' type='ordinal'>
              <calculation class='bin' decimals='0' formula='[Size_MB]' peg='0' size='5' />
            </column>
            <column caption='Size MB' datatype='real' name='[Size_MB]' role='measure' type='quantitative' />
            <column datatype='string' name='[Type]' role='dimension' type='nominal' />
            <column-instance column='[Rating]' derivation='Avg' name='[avg:Rating:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Category]' derivation='None' name='[none:Category:nk]' pivot='key' type='nominal' />
            <column-instance column='[Content_Rating]' derivation='None' name='[none:Content_Rating:nk]' pivot='key' type='nominal' />
            <column-instance column='[Type]' derivation='None' name='[none:Type:nk]' pivot='key' type='nominal' />
            <column-instance column='[Rating]' derivation='Sum' name='[sum:Rating:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1w4hbcd0u7kkkb15605f714jhjb2].[Action (Size MB (bin))]'>
            <groupfilter function='level-members' level='[Size MB (bin)]' />
          </filter>
          <filter class='categorical' column='[federated.1w4hbcd0u7kkkb15605f714jhjb2].[Action (Size Tier (MB))]'>
            <groupfilter function='level-members' level='[Calculation_0345022312833026]' user:ui-action-filter='[Action7_339C982D3E2C46AE81A91F3ECEB32DA0]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.1w4hbcd0u7kkkb15605f714jhjb2].[Action (Type)]'>
            <groupfilter function='level-members' level='[Type]' user:ui-action-filter='[Action7_EA035996B617446F84866C09C5B02F22]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.1w4hbcd0u7kkkb15605f714jhjb2].[none:Category:nk]'>
